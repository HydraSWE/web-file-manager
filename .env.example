# Hydra Web File Manager Environment Template
# Copy this file to .env and customize as needed.

# Optional: Remote Halftone QR Code API endpoint.
# If omitted or empty, the server automatically uses the built-in offline local generator.
HYDRA_CLOUD_QR_API=https://hydra-qr-gen.vercel.app/api/generate

# Optional overrides:
# PORT=8088
# PIN=your_optional_pin
# APP_NAME=Web File Manager
